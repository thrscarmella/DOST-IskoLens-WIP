# Copy this file to .env (in the iskolens folder) and fill in the values.

# A long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me

# Database. MySQL in production (create the database first; see README):
#   DATABASE_URL=mysql://iskolens:your-password@localhost:3306/iskolens
# WAMP's default MySQL user:  mysql://root:@localhost:3306/iskolens
# Leave it out to use a local SQLite test file (instance/iskolens-dev.db, the same file v3 used).
DATABASE_URL=

# Web server
PORT=5000
HOST=127.0.0.1
# The address people type to open IskoLens (used in reset and invitation emails), e.g. https://iskolens.com
PUBLIC_BASE_URL=http://localhost:5000
# Production behind Nginx with HTTPS: set both to 1.
FORCE_HTTPS=0
TRUST_PROXY=0

# Email (leave MAIL_SERVER empty to save emails to instance/outbox instead of sending)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=DOST-IskoLens <no-reply@your-domain>

# Backups: encryption key. KEEP A COPY OUTSIDE THIS COMPUTER; a backup cannot be restored without it.
BACKUP_KEY=
BACKUP_DIR=
BACKUP_KEEP=30
# Optional: let the server run the daily backup and weekly digest itself (cron format).
# Leave empty if you schedule them with Windows Task Scheduler instead.
BACKUP_SCHEDULE=0 2 * * *
DIGEST_SCHEDULE=0 7 * * 1

# Two-step verification (authenticator app) for Administrators.
# Set to 1 in production: Administrators must set it up in My Profile > Security before using the system.
REQUIRE_ADMIN_2FA=0
# Public officer sign-up (with Administrator approval). Set to 0 so only Administrators create accounts.
ALLOW_SIGNUP=1

# Security limits (defaults match the manuscript)
SESSION_IDLE_MINUTES=30
MAX_FAILED_LOGINS=5
RATE_LIMIT_FAILED_LOGINS=20
RATE_LIMIT_PASSWORD_RESETS=5
RATE_LIMIT_SIGNUPS=10

# Academic standing thresholds (revised BPMN). Confirm the equivalents with DOST Davao Oriental.
GWA_REQUIRED_PERCENT_LOWER_YEARS=85
GWA_PASSING_PERCENT=75
GWA_REQUIRED_GRADE_LOWER_YEARS=2.00
GWA_PASSING_GRADE=3.00

# Data retention follows the records retention policy of DOST Davao Oriental as data controller.
RETENTION_YEARS=5
DPO_NAME=Data Protection Officer, DOST Davao Oriental
DPO_EMAIL=dpo@your-office.gov.ph

# Python analytics service (see analytics/README section in README.md)
ANALYTICS_URL=http://127.0.0.1:8001
